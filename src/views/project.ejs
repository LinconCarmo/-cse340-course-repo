<%- include('partials/header') %>

<main>
    <h1><%= project.name %></h1>

    <p><%= project.description %></p>
    <p>
        Organization:
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>
    <p>Date: <%= new Date(project.project_date).toLocaleDateString('en-US', { timeZone: 'UTC' }) %></p>

    <h2>Categories</h2>
    <% if (categories.length) { %>
        <ul class="category-tags">
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>This project has no categories yet.</p>
    <% } %>
</main>

<%- include('partials/footer') %>
