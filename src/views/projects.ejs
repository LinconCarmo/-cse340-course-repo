<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Our Upcoming Service Projects</h2>

    <p>Explore the service projects available in our community.</p>

    <div class="projects-list">
        <% projects.forEach(project => { %>
            <article class="project">
                <h3>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.name %>
                    </a>
                </h3>
                <p>
                    Organization:
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </p>
                <p>Date: <%= new Date(project.project_date).toLocaleDateString('en-US', { timeZone: 'UTC' }) %></p>
            </article>
        <% }); %>
    </div>
</main>

<%- include('partials/footer') %>